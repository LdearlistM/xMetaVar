[Sun Aug  9 02:41:21 2026]
localrule finalize_cnv_analysis:
    input: /pipeline/results/02-variant-calling/SV/CNV/across_sample/genes/genes_summary.tsv
    output: /pipeline/results/02-variant-calling/SV/CNV/across_sample/merge.genes_copynum.tsv, /pipeline/results/logs/MIDASv3/cnv_done.txt
    log: /pipeline/results/logs/MIDASv3/finalize_cnv.log
    jobid: 19
    reason: Missing output files: /pipeline/results/logs/MIDASv3/cnv_done.txt, /pipeline/results/02-variant-calling/SV/CNV/across_sample/merge.genes_copynum.tsv; Input files updated by another job: /pipeline/results/02-variant-calling/SV/CNV/across_sample/genes/genes_summary.tsv
    resources: tmpdir=/tmp


        (
            python -c '
import pandas as pd
import lz4.frame
import os
import glob
import sys

genes_dir = r"/pipeline/results/02-variant-calling/SV/CNV/across_sample/genes"
output_file = r"/pipeline/results/02-variant-calling/SV/CNV/across_sample/merge.genes_copynum.tsv"

try:
    lz4_files = glob.glob(os.path.join(genes_dir, "*", "*.genes_copynum.tsv.lz4"))

    if not lz4_files:
        print("No .lz4 files found to merge.", file=sys.stderr)
        with open(output_file, "w") as f:
            f.write("cluster_id\n")
        sys.exit(0)

    all_dfs = []
    for lz4_file in lz4_files:
        try:
            with lz4.frame.open(lz4_file, "rt", encoding="utf-8") as f:
                df = pd.read_csv(f, sep="\t")
                if not df.empty:
                    df.set_index(df.columns[0], inplace=True)
                    all_dfs.append(df)
        except Exception as e:
            print(f"Warning: Could not process file {lz4_file}. Error: {e}", file=sys.stderr)

    if not all_dfs:
        print("Failed to read any .lz4 files.", file=sys.stderr)
        with open(output_file, "w") as f:
            f.write("cluster_id\n")
        sys.exit(0)

    final_df = pd.concat(all_dfs, axis=0, sort=False).groupby(level=0).sum().fillna(0.000000)
    final_df.reset_index(inplace=True)
    final_df.to_csv(output_file, sep="\t", index=False)

    print(f"Successfully merged {len(all_dfs)} files into the output file.")

except Exception as e:
    print(f"An unexpected error occurred: {e}", file=sys.stderr)
    sys.exit(1)
' > /pipeline/results/logs/MIDASv3/finalize_cnv.log 2>&1
        ) && rm -rf /pipeline/results/02-variant-calling/SV/CNV/single_sample /pipeline/results/02-variant-calling/SV/CNV/across_sample/bt2_indexes
        
